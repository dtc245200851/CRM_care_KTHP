# ============================================
# CRM Care - Environment Variables Example
# Copy this file to .env and fill in values
# NEVER commit .env to git!
# ============================================

# PostgreSQL Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=crm_care
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=CrmCare@SecureP@ss2024!

# PostgreSQL Superuser (for init only)
POSTGRES_INITDB_USER=postgres
POSTGRES_INITDB_PASSWORD=P0stgresAdm1n@2024!

# Backend
NODE_ENV=production
PORT=5000
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=24h
DATABASE_URL=postgresql://crm_user:CrmCare@SecureP@ss2024!@postgres:5432/crm_care?schema=public

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@crmcare.local
PGADMIN_DEFAULT_PASSWORD=PgAdm1n@SecureP@ss2024!
PGADMIN_LISTEN_PORT=80

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=Gr@fana@SecureP@ss2024!
GF_USERS_ALLOW_SIGN_UP=false

# postgres_exporter (read-only monitoring user)
DATA_SOURCE_NAME=postgresql://crm_monitor:Mon1tor@P@ss2024!@postgres:5432/crm_care?sslmode=disable
POSTGRES_EXPORTER_USER=crm_monitor
POSTGRES_EXPORTER_PASSWORD=Mon1tor@P@ss2024!

# Environment label for logs
ENVIRONMENT=production
